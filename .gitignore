# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Generated by `daemonize compile` (regenerate with: daemonize compile)
daemonize-out/

# Recording safety copies written when a browser or program stops mid-session
*.recovery.json

# Playwright storage state: contains session cookies and tokens, never commit
*.storage-state.json
storage-state.json
auth.json
.auth/

# Secrets and local configuration
.env
.env.*
!.env.example

# Test and tooling artifacts
coverage/
test-results/
playwright-report/
.vitest-cache/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Heal mode cache (locators a model repaired); local to a machine
.daemonize/

# Studio UI screenshots (STUDIO_SCREENSHOTS=1)
tests/__screenshots__/

# Static Studio demo (npm run studio:build)
dist-demo/

# Output of 'daemonize compile examples/<name>/daemonize.workflows.json' (regenerate it, do not commit)
examples/*/out/
