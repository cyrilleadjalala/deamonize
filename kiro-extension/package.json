{
  "name": "daemonize-kiro",
  "displayName": "Daemonize",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "daemonize",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cyrilleadjalala/deamonize.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#19161d",
    "theme": "dark"
  },
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "%capabilities.untrusted%"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "%capabilities.virtual%"
    }
  },
  "activationEvents": [
    "onView:daemonize.actions",
    "onView:daemonize.credentials",
    "onView:daemonize.kiro",
    "onView:daemonize.activity",
    "onCommand:daemonize.start",
    "onCommand:daemonize.stop",
    "onCommand:daemonize.restart",
    "onCommand:daemonize.openStudio",
    "onCommand:daemonize.testInStudio",
    "onCommand:daemonize.deleteAction",
    "onCommand:daemonize.newAction",
    "onCommand:daemonize.finishRecording",
    "onCommand:daemonize.refresh",
    "onCommand:daemonize.connectToKiro",
    "onCommand:daemonize.removeFromKiro",
    "onCommand:daemonize.setCredential",
    "onCommand:daemonize.forgetCredential",
    "onCommand:daemonize.showLog",
    "onCommand:daemonize.chooseCliFile",
    "onCommand:daemonize.buildWithAgent",
    "onCommand:daemonize.installCli",
    "onCommand:daemonize.checkBrowser",
    "onCommand:daemonize.getStarted",
    "onCommand:daemonize.openActivity",
    "onCommand:daemonize.approve",
    "onCommand:daemonize.deny",
    "onCommand:daemonize.toggleAskBeforeChanges",
    "onCommand:daemonize.installPower",
    "onCommand:daemonize.removePower"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "daemonize",
          "title": "%container.title%",
          "icon": "media/daemonize.svg"
        }
      ]
    },
    "views": {
      "daemonize": [
        {
          "id": "daemonize.actions",
          "name": "%view.actions%"
        },
        {
          "id": "daemonize.credentials",
          "name": "%view.credentials%"
        },
        {
          "id": "daemonize.kiro",
          "name": "%view.kiro%"
        },
        {
          "id": "daemonize.activity",
          "name": "%view.activity%"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "daemonize.actions",
        "contents": "%welcome.noFolder%",
        "when": "workspaceFolderCount == 0"
      },
      {
        "view": "daemonize.actions",
        "contents": "%welcome.install%",
        "when": "!daemonize.cliFound"
      },
      {
        "view": "daemonize.actions",
        "contents": "%welcome.firstAction%",
        "when": "daemonize.cliFound && daemonize.actionCount == 0 && !daemonize.browserMissing"
      },
      {
        "view": "daemonize.actions",
        "contents": "%welcome.browserMissing%",
        "when": "daemonize.cliFound && daemonize.actionCount == 0 && daemonize.browserMissing"
      },
      {
        "view": "daemonize.kiro",
        "contents": "%welcome.addToKiro%",
        "when": "daemonize.cliFound && daemonize.actionCount > 0 && daemonize.installCount == 0"
      }
    ],
    "walkthroughs": [
      {
        "id": "daemonize.getStarted",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "daemonize.getStarted.install",
            "title": "%walkthrough.install.title%",
            "description": "%walkthrough.install.description%",
            "media": {
              "markdown": "media/walkthrough/install.md"
            },
            "completionEvents": [
              "onCommand:daemonize.installCli",
              "onContext:daemonize.cliFound"
            ]
          },
          {
            "id": "daemonize.getStarted.studio",
            "title": "%walkthrough.studio.title%",
            "description": "%walkthrough.studio.description%",
            "media": {
              "markdown": "media/walkthrough/studio.md"
            },
            "completionEvents": [
              "onCommand:daemonize.openStudio"
            ]
          },
          {
            "id": "daemonize.getStarted.action",
            "title": "%walkthrough.action.title%",
            "description": "%walkthrough.action.description%",
            "media": {
              "markdown": "media/walkthrough/action.md"
            },
            "completionEvents": [
              "onCommand:daemonize.finishRecording"
            ]
          },
          {
            "id": "daemonize.getStarted.test",
            "title": "%walkthrough.test.title%",
            "description": "%walkthrough.test.description%",
            "media": {
              "markdown": "media/walkthrough/test.md"
            },
            "completionEvents": [
              "onCommand:daemonize.testInStudio"
            ]
          },
          {
            "id": "daemonize.getStarted.kiro",
            "title": "%walkthrough.kiro.title%",
            "description": "%walkthrough.kiro.description%",
            "media": {
              "markdown": "media/walkthrough/kiro.md"
            },
            "completionEvents": [
              "onCommand:daemonize.connectToKiro"
            ]
          },
          {
            "id": "daemonize.getStarted.agent",
            "title": "%walkthrough.agent.title%",
            "description": "%walkthrough.agent.description%",
            "media": {
              "markdown": "media/walkthrough/agent.md"
            },
            "completionEvents": [
              "onCommand:daemonize.buildWithAgent"
            ]
          }
        ]
      }
    ],
    "commands": [
      {
        "command": "daemonize.start",
        "title": "%command.start%",
        "category": "Daemonize"
      },
      {
        "command": "daemonize.stop",
        "title": "%command.stop%",
        "category": "Daemonize"
      },
      {
        "command": "daemonize.restart",
        "title": "%command.restart%",
        "category": "Daemonize",
        "icon": "$(debug-restart)"
      },
      {
        "command": "daemonize.openStudio",
        "title": "%command.openStudio%",
        "category": "Daemonize",
        "icon": "$(link-external)"
      },
      {
        "command": "daemonize.testInStudio",
        "title": "%command.testInStudio%",
        "category": "Daemonize",
        "icon": "$(play)"
      },
      {
        "command": "daemonize.deleteAction",
        "title": "%command.deleteAction%",
        "category": "Daemonize",
        "icon": "$(trash)"
      },
      {
        "command": "daemonize.newAction",
        "title": "%command.newAction%",
        "category": "Daemonize",
        "icon": "$(add)"
      },
      {
        "command": "daemonize.finishRecording",
        "title": "%command.finishRecording%",
        "category": "Daemonize",
        "icon": "$(check)"
      },
      {
        "command": "daemonize.refresh",
        "title": "%command.refresh%",
        "category": "Daemonize",
        "icon": "$(refresh)"
      },
      {
        "command": "daemonize.connectToKiro",
        "title": "%command.connectToKiro%",
        "category": "Daemonize",
        "icon": "$(plug)"
      },
      {
        "command": "daemonize.removeFromKiro",
        "title": "%command.removeFromKiro%",
        "category": "Daemonize",
        "icon": "$(trash)"
      },
      {
        "command": "daemonize.setCredential",
        "title": "%command.setCredential%",
        "category": "Daemonize",
        "icon": "$(key)"
      },
      {
        "command": "daemonize.forgetCredential",
        "title": "%command.forgetCredential%",
        "category": "Daemonize",
        "icon": "$(close)"
      },
      {
        "command": "daemonize.showLog",
        "title": "%command.showLog%",
        "category": "Daemonize"
      },
      {
        "command": "daemonize.chooseCliFile",
        "title": "%command.chooseCliFile%",
        "category": "Daemonize"
      },
      {
        "command": "daemonize.buildWithAgent",
        "title": "%command.buildWithAgent%",
        "category": "Daemonize",
        "icon": "$(sparkle)"
      },
      {
        "command": "daemonize.installCli",
        "title": "%command.installCli%",
        "icon": "$(cloud-download)"
      },
      {
        "command": "daemonize.checkBrowser",
        "title": "%command.checkBrowser%"
      },
      {
        "command": "daemonize.getStarted",
        "title": "%command.getStarted%"
      },
      {
        "command": "daemonize.openActivity",
        "title": "%command.openActivity%",
        "category": "Daemonize",
        "icon": "$(link-external)"
      },
      {
        "command": "daemonize.approve",
        "title": "%command.approve%",
        "category": "Daemonize",
        "icon": "$(check)"
      },
      {
        "command": "daemonize.deny",
        "title": "%command.deny%",
        "category": "Daemonize",
        "icon": "$(close)"
      },
      {
        "command": "daemonize.toggleAskBeforeChanges",
        "title": "%command.toggleAskBeforeChanges%",
        "category": "Daemonize",
        "icon": "$(shield)"
      },
      {
        "command": "daemonize.installPower",
        "title": "%command.installPower%",
        "category": "Daemonize",
        "icon": "$(add)"
      },
      {
        "command": "daemonize.removePower",
        "title": "%command.removePower%",
        "category": "Daemonize",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "daemonize.newAction",
          "when": "view == daemonize.actions",
          "group": "navigation@1"
        },
        {
          "command": "daemonize.finishRecording",
          "when": "view == daemonize.actions && daemonize.recording",
          "group": "navigation@2"
        },
        {
          "command": "daemonize.openStudio",
          "when": "view == daemonize.actions",
          "group": "navigation@3"
        },
        {
          "command": "daemonize.refresh",
          "when": "view == daemonize.actions || view == daemonize.credentials || view == daemonize.kiro || view == daemonize.activity",
          "group": "navigation@4"
        },
        {
          "command": "daemonize.restart",
          "when": "view == daemonize.actions",
          "group": "navigation@5"
        },
        {
          "command": "daemonize.buildWithAgent",
          "when": "view == daemonize.actions",
          "group": "navigation@6"
        },
        {
          "command": "daemonize.connectToKiro",
          "when": "view == daemonize.kiro",
          "group": "navigation@1"
        },
        {
          "command": "daemonize.installPower",
          "when": "view == daemonize.kiro",
          "group": "navigation@2"
        },
        {
          "command": "daemonize.openActivity",
          "when": "view == daemonize.activity",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "daemonize.testInStudio",
          "when": "view == daemonize.actions && viewItem == action",
          "group": "inline@1"
        },
        {
          "command": "daemonize.connectToKiro",
          "when": "view == daemonize.actions && viewItem == action",
          "group": "inline@2"
        },
        {
          "command": "daemonize.deleteAction",
          "when": "view == daemonize.actions && viewItem == action",
          "group": "inline@3"
        },
        {
          "command": "daemonize.setCredential",
          "when": "view == daemonize.credentials && viewItem =~ /^secret/",
          "group": "inline@1"
        },
        {
          "command": "daemonize.forgetCredential",
          "when": "view == daemonize.credentials && viewItem == secret.configured",
          "group": "inline@2"
        },
        {
          "command": "daemonize.removeFromKiro",
          "when": "view == daemonize.kiro && viewItem == install",
          "group": "inline@1"
        },
        {
          "command": "daemonize.toggleAskBeforeChanges",
          "when": "view == daemonize.kiro && viewItem == install",
          "group": "inline@2"
        },
        {
          "command": "daemonize.removePower",
          "when": "view == daemonize.kiro && viewItem == power",
          "group": "inline@1"
        },
        {
          "command": "daemonize.approve",
          "when": "view == daemonize.activity && viewItem == approval",
          "group": "inline@1"
        },
        {
          "command": "daemonize.deny",
          "when": "view == daemonize.activity && viewItem == approval",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "daemonize.deleteAction",
          "when": "false"
        },
        {
          "command": "daemonize.approve",
          "when": "false"
        },
        {
          "command": "daemonize.deny",
          "when": "false"
        },
        {
          "command": "daemonize.toggleAskBeforeChanges",
          "when": "false"
        },
        {
          "command": "daemonize.finishRecording",
          "when": "daemonize.recording"
        }
      ]
    },
    "configuration": {
      "title": "Daemonize",
      "properties": {
        "daemonize.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.cliPath%"
        },
        "daemonize.nodePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%config.nodePath%"
        }
      }
    }
  },
  "scripts": {
    "bundle": "node scripts/bundle.mjs",
    "build": "node scripts/bundle.mjs --production",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies",
    "ls": "vsce ls --no-dependencies",
    "icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.2.1",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  }
}