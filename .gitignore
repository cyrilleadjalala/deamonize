# Dependencies and build output
node_modules/
dist/
*.tsbuildinfo

# Generated by `daemonize compile` (regenerate with: daemonize compile)
daemonize-out/

# Recording safety copies written when a browser or program stops mid-session
*.recovery.json

# Playwright storage state: contains session cookies and tokens, never commit
*.storage-state.json
storage-state.json
auth.json
.auth/

# Secrets and local configuration
.env
.env.*
!.env.example

# Test and tooling artifacts
coverage/
test-results/
playwright-report/
.vitest-cache/

# Logs
*.log
npm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
.idea/

# Heal mode cache (locators a model repaired); local to a machine
.daemonize/

# Studio UI screenshots (STUDIO_SCREENSHOTS=1)
tests/__screenshots__/

# Static Studio demo (npm run studio:build)
dist-demo/

# Output of 'daemonize compile examples/<name>/daemonize.workflows.json' (regenerate it, do not commit)
examples/*/out/

# Studio first flow: stray copies of the vault, its key and half-written session files
secrets.vault.json
secrets.vault.json.tmp-*
vault.key
vault.key.test
*.storage-state.json.tmp-*
# Thin Kiro extension: build output, packages and dependencies
kiro-extension/dist/
kiro-extension/*.vsix
kiro-extension/node_modules/
# Local recordings and agent notes at the repository root (examples/ keep their tracked workflow files)
/daemonize.workflows.json
/daemonize.workflows.json.assets/
/.agents/
# The real Kiro MCP settings of this workspace stay local (copy .kiro/settings/mcp.json.example to create it)
.kiro/settings/mcp.json
# Output of the extension build: templates bundled from power/
kiro-extension/templates/
